# --- Server ---
PORT=3000
NODE_ENV=development
# Public https base URL. OAuth redirects and Twilio webhooks are derived from it.
# In dev this is your ngrok URL; on Render it's filled in automatically.
APP_URL=https://example.ngrok.app

# --- Twilio (one platform account; each barber gets a number under it) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# ISO country to buy barber numbers in
TWILIO_NUMBER_COUNTRY=US
# Set to false only for local testing without real Twilio signatures
VALIDATE_TWILIO_SIGNATURE=true
# "twilio" sends real texts; "console" just logs them. Local testing only.
SMS_TRANSPORT=twilio

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Google OAuth (one web client; every barber signs in through it) ---
# Authorized redirect URI must be exactly: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# --- Secrets ---
# Encrypts each barber's Google refresh token at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Storage ---
DATABASE_PATH=./data/app.sqlite

# --- Defaults applied to a barber's profile at signup (each is editable in the dashboard) ---
DEFAULT_TIMEZONE=America/New_York
DEFAULT_BUSINESS_HOURS=1:09:00-17:00,2:09:00-17:00,3:09:00-17:00,4:09:00-19:00,5:09:00-19:00,6:10:00-16:00
DEFAULT_APPOINTMENT_DURATION_MINUTES=45
